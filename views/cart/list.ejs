<!DOCTYPE html>
<html lang="th">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>ตะกร้าสินค้า | UTK-Store</title>

    <link
        rel="stylesheet"
        href="/css/tabler.min.css"
    >

</head>


<body>


    <!-- ========================= -->
    <!-- Navbar -->
    <!-- ========================= -->

    <header class="navbar navbar-expand-md d-print-none">

        <div class="container-xl">

            <a
                href="/"
                class="navbar-brand navbar-brand-autodark"
            >
                UTK-Store
            </a>


            <div class="navbar-nav flex-row order-md-last ms-auto">

                <a
                    href="/products"
                    class="btn btn-outline-secondary me-2"
                >
                    ← สินค้า
                </a>

                <a
                    href="/cart"
                    class="btn btn-primary"
                >
                    🛒 รถเข็น
                </a>

            </div>

        </div>

    </header>



    <!-- ========================= -->
    <!-- Page -->
    <!-- ========================= -->

    <div class="page">

        <div class="page-wrapper">


            <!-- Page Header -->

            <div class="page-header d-print-none">

                <div class="container-xl">

                    <div class="row align-items-center">

                        <div class="col">

                            <h2 class="page-title">
                                ตะกร้าสินค้า
                            </h2>

                            <div class="text-secondary mt-1">
                                ตรวจสอบสินค้าและจำนวนก่อนสั่งซื้อ
                            </div>

                        </div>

                    </div>

                </div>

            </div>



            <!-- Page Body -->

            <div class="page-body">

                <div class="container-xl">


                    <% if (items.length === 0) { %>


                        <!-- ========================= -->
                        <!-- Empty Cart -->
                        <!-- ========================= -->

                        <div class="empty">

                            <div class="empty-img">
                                🛒
                            </div>

                            <p class="empty-title">
                                ตะกร้าสินค้าว่าง
                            </p>

                            <p class="empty-subtitle text-secondary">
                                ยังไม่มีสินค้าในตะกร้า
                            </p>

                            <div class="empty-action">

                                <a
                                    href="/products"
                                    class="btn btn-primary"
                                >
                                    🛍️ เลือกสินค้า
                                </a>

                            </div>

                        </div>


                    <% } else { %>


                        <div class="row row-cards">


                            <!-- ========================= -->
                            <!-- Cart Items -->
                            <!-- ========================= -->

                            <div class="col-lg-8">


                                <% items.forEach(item => { %>


                                    <div class="card mb-3">


                                        <div class="card-body">


                                            <div class="row align-items-center">


                                                <!-- Product Icon -->

                                                <div class="col-auto">

                                                    <span
                                                        class="avatar avatar-lg bg-blue-lt"
                                                    >
                                                        🛍️
                                                    </span>

                                                </div>


                                                <!-- Product Info -->

                                                <div class="col">

                                                    <h3 class="card-title mb-1">

                                                        <%= item.name %>

                                                    </h3>


                                                    <div class="text-secondary">

                                                        ราคา:
                                                        <%= Number(item.price).toLocaleString("th-TH", {
                                                            minimumFractionDigits: 2,
                                                            maximumFractionDigits: 2
                                                        }) %>
                                                        บาท

                                                    </div>


                                                    <div class="mt-2">

                                                        <% if (item.size) { %>
                                                        <span class="badge bg-blue-lt me-1">

                                                            Size:
                                                            <%= item.size || "-" %>

                                                        </span>
                                                        <% } %>


                                                        <% if (item.color) { %>
                                                        <span class="badge bg-purple-lt">

                                                            สี:
                                                            <%= item.color || "-" %>

                                                        </span>
                                                        <% } %>

                                                    </div>

                                                </div>


                                                <!-- Quantity -->

                                                <div class="col-md-auto mt-3 mt-md-0">


                                                    <form
                                                        action="/cart/update"
                                                        method="POST"
                                                        class="cart-update-form"
                                                    >

                                                        <input
                                                            type="hidden"
                                                            name="variant_id"
                                                            value="<%= item.variant_id %>"
                                                        >


                                                        <label class="form-label">
                                                            จำนวน
                                                        </label>


                                                        <div class="input-group">

                                                            <input
                                                                type="number"
                                                                name="quantity"
                                                                value="<%= item.quantity %>"
                                                                min="1"
                                                                class="form-control"
                                                                style="width: 80px;"
                                                                required
                                                            >


                                                            <button
                                                                type="submit"
                                                                class="btn btn-outline-primary"
                                                            >
                                                                อัปเดต
                                                            </button>

                                                        </div>

                                                    </form>


                                                </div>


                                                <!-- Remove -->

                                                <div class="col-auto mt-3 mt-md-0" >

                                                    <form
                                                        action="/cart/remove"
                                                        method="POST"
                                                        class="cart-remove-form"
                                                    >

                                                        <input
                                                            type="hidden"
                                                            name="variant_id"
                                                            value="<%= item.variant_id %>"
                                                        >


                                                        <button
                                                            type="submit"
                                                            class="btn btn-outline-danger"
                                                        >
                                                            ลบ
                                                        </button>

                                                    </form>

                                                </div>


                                            </div>

                                        </div>


                                    </div>


                                <% }) %>


                            </div>



                            <!-- ========================= -->
                            <!-- Order Summary -->
                            <!-- ========================= -->

                            <div class="col-lg-4">


                                <div
                                    class="card"
                                    style="position: sticky; top: 20px;"
                                >


                                    <div class="card-header">

                                        <h3 class="card-title">
                                            สรุปคำสั่งซื้อ
                                        </h3>

                                    </div>


                                    <div class="card-body">


                                        <div class="d-flex justify-content-between mb-3">

                                            <span class="text-secondary">
                                                จำนวนสินค้า
                                            </span>

                                            <span class="fw-bold">

                                                <%= items.reduce((sum, item) => {
                                                    return sum + Number(item.quantity);
                                                }, 0) %>

                                                ชิ้น

                                            </span>

                                        </div>


                                        <div class="d-flex justify-content-between mb-3">

                                            <span class="text-secondary">
                                                ยอดรวม
                                            </span>

                                            <span class="h2 mb-0 text-primary">

                                                <%= Number(total).toLocaleString("th-TH", {
                                                    minimumFractionDigits: 2,
                                                    maximumFractionDigits: 2
                                                }) %>

                                                บาท

                                            </span>

                                        </div>


                                        <hr>


                                        <a
                                            href="/orders/checkout"
                                            class="btn btn-primary w-100"
                                        >
                                            ดำเนินการสั่งซื้อ
                                        </a>


                                    </div>


                                </div>


                            </div>


                        </div>


                        <!-- Back -->

                        <div class="mt-4">

                            <a
                                href="/products"
                                class="btn btn-outline-secondary"
                            >
                                ← กลับไปเลือกสินค้า
                            </a>

                        </div>


                    <% } %>


                </div>

            </div>


        </div>

    </div>


    <!-- Toast แจ้งเตือน -->
    <div
        id="cart-toast"
        class="toast position-fixed top-0 end-0 m-3"
        role="alert"
        style="z-index: 9999;"
    >
        <div class="toast-body">
            <span id="cart-toast-message"></span>
        </div>
    </div>


    <!-- Tabler JS -->

    <script src="/js/tabler.min.js"></script>

    <script>

    // ======================================== 
    // แสดง Toast
    // ========================================


        function showToast(message, type = "danger") {

            const toast = document.querySelector("#cart-toast");

            const messageBox = document.querySelector("#cart-toast-message");


            // ล้างสีเดิมก่อน
            toast.classList.remove(
                "text-bg-danger",
                "text-bg-success",
                "text-bg-warning"
            );


            // กำหนดสีตามประเภท
            toast.classList.add(
                `text-bg-${type}`
            );


            // ใส่ข้อความ
            messageBox.textContent = message;


            // แสดง Toast
            toast.classList.add("show");


            // ซ่อนหลัง 3 วินาที
            setTimeout(() => {

                toast.classList.remove("show");

            }, 3000);

        }

        // ========================================
        // ดักการกดปุ่ม "อัปเดต"
        // ========================================
        
        const updateForms = document.querySelectorAll(".cart-update-form");

        updateForms.forEach(form => {

            form.addEventListener("submit", async function (event) {

                // ป้องกัน Form ส่งแบบปกติ
                event.preventDefault();


                // เก็บข้อมูลจาก Form
                const formData = new URLSearchParams(new FormData(this));
                try {
                    // ส่งข้อมูลไป Backend
                    const response =
                        await fetch(
                            this.action,
                            {
                                method: "POST",
                                body: formData
                            }
                        );


                    // ถ้า Backend ตอบ Error
                    if (!response.ok) {

                        // อ่านข้อความ Error จาก Backend
                        const message = await response.text();

                        // แสดง Toast
                        showToast(message, "danger");

                        return;
                    }


                    // ถ้า Update สำเร็จ
                    // แสดงข้อความสำเร็จ
                    showToast(
                        "อัปเดตจำนวนสินค้าเรียบร้อย",
                        "success"
                    );

                    // รอให้เห็น Toast ก่อนแล้วค่อย Reload
                    setTimeout(() => {
                        location.reload();
                    }, 1000);

                    } catch (error) {

                        // กรณีเชื่อมต่อ Server ไม่ได้
                        showToast(
                        "เกิดข้อผิดพลาด กรุณาลองใหม่"
                    );

                    console.error(error);
                }

            });

        });

        // ========================================
        // ดักการกดปุ่ม "ลบ"
        // ========================================
        const removeForms = document.querySelectorAll(".cart-remove-form");

        removeForms.forEach(form => {

            form.addEventListener("submit", async function (event) {

                // ป้องกัน Form ส่งแบบปกติ
                event.preventDefault();


                // ถามยืนยันก่อนลบ
                const confirmRemove =
                    confirm("ต้องการลบสินค้านี้ออกจากตะกร้าหรือไม่?");


                // ถ้าไม่ยืนยัน ให้หยุด
                if (!confirmRemove) {
                    return;
                }


                // เก็บข้อมูลจาก Form
                const formData =
                    new URLSearchParams(new FormData(this));


                try {

                    // ส่งไป Backend
                    const response =
                        await fetch(
                            this.action,
                            {
                                method: "POST",
                                body: formData
                            }
                        );


                    // ถ้าลบไม่สำเร็จ
                    if (!response.ok) {

                        const message =
                            await response.text();

                        showToast(
                            message,
                            "danger"
                        );

                        return;
                    }


                    // ลบสำเร็จ
                    showToast(
                        "ลบสินค้าออกจากตะกร้าเรียบร้อย",
                        "success"
                    );


                    // รอให้เห็น Toast ก่อน Reload
                    setTimeout(() => {
                        location.reload();
                    }, 800);


                } catch (error) {

                    // กรณี Server มีปัญหา
                    showToast(
                        "เกิดข้อผิดพลาด กรุณาลองใหม่",
                        "danger"
                    );

                    console.error(error);
                }

            });

        });

    </script>

</body>

</html>