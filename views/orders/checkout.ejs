<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8" />

        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>สั่งซื้อ | UTK-Store</title>

        <link rel="stylesheet" href="/css/tabler.min.css" />
        <link rel="stylesheet" href="/css/style.css" />
    </head>

    <body>
        <!-- ========================= -->
        <!-- Navbar -->
        <!-- ========================= -->

        <%- include("../partials/user-navbar") %>

        <!-- ========================= -->
        <!-- Page -->
        <!-- ========================= -->

        <div class="page">
            <div class="page-wrapper">
                <!-- ========================= -->
                <!-- Page Header -->
                <!-- ========================= -->

                <div class="page-header d-print-none">
                    <div class="container-xl">
                        <div class="row align-items-center">
                            <div class="col">
                                <h2 class="page-title">ยืนยันการสั่งซื้อ</h2>

                                <div class="text-secondary mt-1">
                                    ตรวจสอบข้อมูลผู้สั่งซื้อก่อนยืนยันคำสั่งซื้อ
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================= -->
                <!-- Page Body -->
                <!-- ========================= -->

                <div class="page-body">
                    <div class="container-xl">
                        <div class="row row-cards">
                            <!-- ========================= -->
                            <!-- Customer Information -->
                            <!-- ========================= -->

                            <div class="col-lg-8">
                                <form
                                    id="checkout-form"
                                    action="/orders/create"
                                    method="POST"
                                    enctype="multipart/form-data"
                                >
                                    <!-- Input ของ Token -->
                                    <input
                                        type="hidden"
                                        name="checkout_token"
                                        value="<%= checkoutToken %>"
                                    />

                                    <div class="card">
                                        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                                            <h3 class="card-title">ข้อมูลผู้สั่งซื้อ</h3>
                                            <div class="d-flex gap-2">
                                                <button id="checkout-edit-contact" type="button" class="btn btn-sm btn-outline-primary" aria-controls="checkout-customer-name checkout-phone" aria-pressed="false">
                                                    <%- include("../partials/tabler-icon", { name: "edit", size: 18 }) %>
                                                    <span class="checkout-edit-label">แก้ไขข้อมูล</span>
                                                </button>
                                                <button id="checkout-cancel-contact" type="button" class="btn btn-sm btn-outline-secondary" hidden>ยกเลิก</button>
                                            </div>
                                        </div>

                                        <div class="card-body">
                                            <div class="text-secondary mb-4">
                                                ข้อมูลเริ่มต้นจากบัญชีของคุณ การแก้ไขมีผลเฉพาะคำสั่งซื้อนี้
                                            </div>
                                            <!-- Name -->

                                            <div class="mb-4">
                                                <label class="form-label"> ชื่อ-นามสกุล </label>

                                                <input
                                                    type="text"
                                                    name="customer_name"
                                                    id="checkout-customer-name"
                                                    value="<%= user.name %>"
                                                    class="form-control checkout-contact-field"
                                                    maxlength="150"
                                                    autocomplete="name"
                                                    readonly
                                                    required
                                                />

                                                <div class="form-hint">
                                                    ชื่อที่ใช้สำหรับคำสั่งซื้อ
                                                </div>
                                            </div>

                                            <!-- Student ID -->

                                            <div class="mb-4">
                                                <label class="form-label"> รหัสนักศึกษา </label>

                                                <input
                                                    type="text"
                                                    value="<%= user.student_id %>"
                                                    class="form-control"
                                                    readonly
                                                    aria-readonly="true"
                                                />

                                                <div class="form-hint">
                                                    รหัสนักศึกษาเชื่อมกับบัญชีและแก้ไขจากหน้านี้ไม่ได้
                                                </div>
                                            </div>

                                            <!-- Phone -->

                                            <div class="mb-4">
                                                <label class="form-label"> เบอร์โทรศัพท์ </label>

                                                <input
                                                    type="text"
                                                    name="phone"
                                                    id="checkout-phone"
                                                    value="<%= user.phone %>"
                                                    class="form-control checkout-contact-field"
                                                    maxlength="20"
                                                    autocomplete="tel"
                                                    readonly
                                                    required
                                                />

                                                <div class="form-hint">
                                                    เบอร์โทรศัพท์สำหรับติดต่อ
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Footer -->

                                        <div class="card-footer d-flex justify-content-between">
                                            <a href="/cart" class="btn btn-outline-secondary">
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="24"
                                                    height="24"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-narrow-left-dashed"
                                                >
                                                    <path
                                                        stroke="none"
                                                        d="M0 0h24v24H0z"
                                                        fill="none"
                                                    />
                                                    <path d="M5 12h6m3 0h1.5m3 0h.5" />
                                                    <path d="M5 12l4 4" />
                                                    <path d="M5 12l4 -4" />
                                                </svg>

                                                กลับไปตะกร้า
                                            </a>

                                            <button type="submit" class="btn btn-primary">
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="24"
                                                    height="24"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    class="icon icon-tabler icons-tabler-outline icon-tabler-check"
                                                >
                                                    <path
                                                        stroke="none"
                                                        d="M0 0h24v24H0z"
                                                        fill="none"
                                                    />
                                                    <path d="M5 12l5 5l10 -10" />
                                                </svg>

                                                ยืนยันการสั่งซื้อ
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>

                            <!-- ========================= -->
                            <!-- Information -->
                            <!-- ========================= -->

                            <div class="col-lg-4">
                                <div class="card mb-3">
                                    <!-- QR Code ร้าน -->
                                    <div class="card">
                                        <div class="card-header">
                                            <h3 class="card-title">QR Code สำหรับชำระเงิน</h3>
                                        </div>

                                        <div class="card-body text-center">
                                            <!-- QR Code ของร้าน -->
                                            <img
                                                src="/images/payment-qr.jpg"
                                                alt="QR Code สำหรับชำระเงิน"
                                                class="img-fluid rounded"
                                                style="max-width: 280px"
                                            />
                                            <div class="text-secondary mt-3">
                                                สแกน QR Code เพื่อชำระเงิน
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- แนบสลิปการชำระเงิน -->
                                <div class="card mb-3">
                                    <div class="card-header">
                                        <h3 class="card-title">แนบสลิปการชำระเงิน</h3>
                                    </div>

                                    <div class="card-body">
                                        <!-- ช่องเลือกไฟล์สลิป -->
                                        <label class="form-label"> หลักฐานการชำระเงิน </label>

                                        <input
                                            type="file"
                                            name="payment_slip"
                                            form="checkout-form"
                                            class="form-control"
                                            accept="image/*"
                                            required
                                        />

                                        <div class="form-hint mt-2">
                                            รองรับไฟล์รูปภาพ JPG, PNG, WEBP ขนาดไม่เกิน 2 MB
                                        </div>
                                    </div>
                                </div>

                                <!-- Warning -->

                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex">
                                            <span class="avatar bg-orange-lt me-3">
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="24"
                                                    height="24"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    class="icon icon-tabler icons-tabler-outline icon-tabler-alert-circle"
                                                >
                                                    <path
                                                        stroke="none"
                                                        d="M0 0h24v24H0z"
                                                        fill="none"
                                                    />
                                                    <path
                                                        d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"
                                                    />
                                                    <path d="M12 8v4" />
                                                    <path d="M12 16h.01" />
                                                </svg>
                                            </span>

                                            <div>
                                                <div class="fw-bold">ก่อนยืนยัน</div>

                                                <div class="text-secondary mt-1">
                                                    เมื่อยืนยันแล้ว ระบบจะสร้างคำสั่งซื้อ
                                                    จากสินค้าในตะกร้าของคุณ
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabler JS -->

        <script src="/js/tabler.min.js"></script>

        <script>
            (() => {
                const editButton = document.getElementById("checkout-edit-contact");
                const cancelButton = document.getElementById("checkout-cancel-contact");
                const editLabel = editButton?.querySelector(".checkout-edit-label");
                const fields = [...document.querySelectorAll(".checkout-contact-field")];
                if (!editButton || !cancelButton || !editLabel || fields.length === 0) return;

                const originalValues = fields.map((field) => field.value);
                const setEditing = (editing) => {
                    fields.forEach((field) => { field.readOnly = !editing; });
                    editButton.setAttribute("aria-pressed", String(editing));
                    editLabel.textContent = editing ? "ใช้ข้อมูลนี้" : "แก้ไขข้อมูล";
                    cancelButton.hidden = !editing;
                    if (editing) fields[0].focus();
                };

                editButton.addEventListener("click", () => {
                    const editing = fields.some((field) => field.readOnly);
                    setEditing(editing);
                });
                cancelButton.addEventListener("click", () => {
                    fields.forEach((field, index) => { field.value = originalValues[index]; });
                    setEditing(false);
                });
            })();
        </script>

        <%- include("../partials/store-footer") %>
    </body>
</html>
