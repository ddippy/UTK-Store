<!DOCTYPE html>
<html lang="th">

  <%- include("../partials/head", { title: "สินค้า | UTK-Store" }) %>

  <body>

    <%- include("../partials/navbar") %>

    <h1>สั่งซื้อสำเร็จ 🎉</h1>

    <p>
      เลขที่คำสั่งซื้อ:
      <strong><%= order.order_id %></strong>
    </p>

    <p>
      ยอดรวม:
      <strong><%= order.total_price %> บาท</strong>
    </p>

    <br />

    <a href="/products"> กลับไปเลือกสินค้า </a>


    <!-- ปุ่มเปิด Modal แบบซ่อนไว้ -->
<button
    type="button"
    id="open-success-modal"
    class="d-none"
    data-bs-toggle="modal"
    data-bs-target="#order-success-modal"
>
    เปิด
</button>

<!-- Modal -->
<div
    class="modal modal-blur fade"
    id="order-success-modal"
    tabindex="-1"
    aria-hidden="true"
>
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-body text-center py-4">

                <div class="mb-3">
                    🎉
                </div>

                <h3>สั่งซื้อสำเร็จ!</h3>

                <div class="text-secondary">
                    ขอบคุณสำหรับการสั่งซื้อ
                </div>

            </div>

            <div class="modal-footer">
                <button
                    type="button"
                    class="btn btn-primary w-100"
                    data-bs-dismiss="modal"
                >
                    ตกลง
                </button>
            </div>

        </div>
    </div>
</div>

<script src="/js/tabler.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelector("#open-success-modal").click();
    });
</script>


  </body>
</html>
