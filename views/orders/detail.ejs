<!DOCTYPE html>
<html lang="th">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>รายละเอียดคำสั่งซื้อ | UTK-Store</title>

    <link
        rel="stylesheet"
        href="/css/tabler.min.css"
    >

</head>


<body>

    <!-- ========================= -->
    <!-- Navbar -->
    <!-- ========================= -->

    <header class="navbar navbar-expand-md d-print-none">

        <div class="container-xl">

            <a
                href="/"
                class="navbar-brand navbar-brand-autodark"
            >
                UTK-Store
            </a>


            <div class="navbar-nav flex-row order-md-last ms-auto">

                <a
                    href="/products"
                    class="btn btn-outline-secondary me-2"
                >
                    🛍️ สินค้า
                </a>


                <a
                    href="/orders/my-orders"
                    class="btn btn-outline-primary me-2"
                >
                    📦 คำสั่งซื้อของฉัน
                </a>


                <a
                    href="/cart"
                    class="btn btn-primary"
                >
                    🛒 รถเข็น
                </a>

            </div>

        </div>

    </header>


    <!-- ========================= -->
    <!-- Page -->
    <!-- ========================= -->

    <div class="page">

        <div class="page-wrapper">


            <!-- ========================= -->
            <!-- Page Header -->
            <!-- ========================= -->

            <div class="page-header d-print-none">

                <div class="container-xl">

                    <div class="row align-items-center">

                        <div class="col">

                            <h2 class="page-title">

                                รายละเอียดคำสั่งซื้อ

                            </h2>

                            <div class="text-secondary mt-1">

                                ตรวจสอบรายละเอียดคำสั่งซื้อของคุณ

                            </div>

                        </div>


                        <div class="col-auto">

                            <a
                                href="/orders/my-orders"
                                class="btn btn-outline-secondary"
                            >
                                ← กลับคำสั่งซื้อ
                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ========================= -->
            <!-- Page Body -->
            <!-- ========================= -->

            <div class="page-body">

                <div class="container-xl">

                    <div class="row row-cards">


                        <!-- ========================= -->
                        <!-- Order Information -->
                        <!-- ========================= -->

                        <div class="col-lg-8">

                            <div class="card">

                                <div class="card-header">

                                    <h3 class="card-title">

                                        รายการสินค้า

                                    </h3>

                                </div>


                                <div class="card-body">

                                    <% if (order.items.length === 0) { %>

                                        <div class="empty">

                                            <p class="empty-title">
                                                ไม่มีรายการสินค้า
                                            </p>

                                        </div>

                                    <% } %>


                                    <% order.items.forEach(item => { %>

                                        <div class="row align-items-center">

                                            <!-- Product -->

                                            <div class="col">

                                                <div class="fw-bold">

                                                    <%= item.name %>

                                                </div>


                                                <div class="text-secondary mt-1">

                                                    <% if (item.size) { %>

                                                        <span class="badge bg-secondary-lt me-1">

                                                            Size:
                                                            <%= item.size %>

                                                        </span>

                                                    <% } %>


                                                    <% if (item.color) { %>

                                                        <span class="badge bg-secondary-lt">

                                                            สี:
                                                            <%= item.color %>

                                                        </span>

                                                    <% } %>

                                                </div>


                                                <div class="text-secondary mt-2">

                                                    จำนวน:
                                                    <%= item.quantity %>
                                                    ชิ้น

                                                </div>

                                            </div>


                                            <!-- Price -->

                                            <div class="col-auto">

                                                <div class="text-end">

                                                    <div class="text-secondary">

                                                        <%= Number(item.price).toLocaleString() %>
                                                        บาท / ชิ้น

                                                    </div>


                                                    <div class="fw-bold">

                                                        <%= Number(
                                                            item.price * item.quantity
                                                        ).toLocaleString() %>

                                                        บาท

                                                    </div>

                                                </div>

                                            </div>

                                        </div>


                                        <hr>


                                    <% }) %>

                                </div>


                                <!-- Total -->

                                <div class="card-body border-top">

                                    <div class="row">

                                        <div class="col">

                                            <strong>
                                                ยอดรวมทั้งหมด
                                            </strong>

                                        </div>


                                        <div class="col-auto">

                                            <strong class="fs-2">

                                                <%= Number(
                                                    order.total_price
                                                ).toLocaleString() %>

                                                บาท

                                            </strong>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ========================= -->
                        <!-- Order Summary -->
                        <!-- ========================= -->

                        <div class="col-lg-4">

                            <!-- Order Status -->

                            <div class="card mb-3">

                                <div class="card-header">

                                    <h3 class="card-title">

                                        สถานะคำสั่งซื้อ

                                    </h3>

                                </div>


                                <div class="card-body">

                                    <% if (order.status === "PENDING") { %>

                                        <span class="badge bg-yellow-lt fs-3">

                                            รอตรวจสอบ

                                        </span>

                                    <% } else if (order.status === "CONFIRMED") { %>

                                        <span class="badge bg-blue-lt fs-3">

                                            ยืนยันแล้ว

                                        </span>

                                    <% } else if (order.status === "COMPLETED") { %>

                                        <span class="badge bg-green-lt fs-3">

                                            สำเร็จ

                                        </span>

                                    <% } else if (order.status === "CANCELLED") { %>

                                        <span class="badge bg-red-lt fs-3">

                                            ยกเลิก

                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-secondary-lt fs-3">

                                            <%= order.status %>

                                        </span>

                                    <% } %>

                                </div>

                            </div>


                            <!-- Customer Information -->

                            <div class="card mb-3">

                                <div class="card-header">

                                    <h3 class="card-title">

                                        ข้อมูลผู้สั่งซื้อ

                                    </h3>

                                </div>


                                <div class="card-body">

                                    <div class="mb-3">

                                        <div class="text-secondary">
                                            ชื่อผู้สั่ง
                                        </div>

                                        <div class="fw-bold">
                                            <%= order.customer_name %>
                                        </div>

                                    </div>


                                    <div class="mb-3">

                                        <div class="text-secondary">
                                            รหัสนักศึกษา
                                        </div>

                                        <div class="fw-bold">
                                            <%= order.student_id %>
                                        </div>

                                    </div>


                                    <div>

                                        <div class="text-secondary">
                                            เบอร์โทรศัพท์
                                        </div>

                                        <div class="fw-bold">
                                            <%= order.phone %>
                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- Payment Slip -->

                            <div class="card">

                                <div class="card-header">

                                    <h3 class="card-title">

                                        สลิปการชำระเงิน

                                    </h3>

                                </div>


                                <div class="card-body">

                                    <% if (order.payment_slip_path) { %>

                                        <a
                                            href="<%= order.payment_slip_path %>"
                                            target="_blank"
                                            class="btn btn-outline-primary w-100"
                                        >

                                            🧾 ดูสลิปการชำระเงิน

                                        </a>

                                    <% } else { %>

                                        <div class="text-secondary">

                                            ไม่พบสลิปการชำระเงิน

                                        </div>

                                    <% } %>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


</body>

</html>