<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>เกี่ยวกับเรา | UTK-Store</title>
        <link rel="stylesheet" href="/css/tabler.min.css" />
        <link rel="stylesheet" href="/css/style.css" />
    </head>
    <body class="about-page-shell">
        <%- include("./partials/user-navbar") %>

        <main class="page-wrapper about-help-page">
            <div class="container-xl">
                <div class="about-help-layout">
                    <aside class="about-help-sidebar" aria-label="เมนูข้อมูลร้านค้า">
                        <div class="about-help-sidebar-title">ข้อมูลร้านค้า</div>
                        <div class="about-help-tabs" role="tablist" aria-orientation="vertical" aria-label="เลือกหัวข้อ">
                            <button class="about-help-tab" id="about-tab-contact" type="button" role="tab" aria-selected="false" aria-controls="about-panel-contact" data-about-tab="contact">
                                <%- include("./partials/tabler-icon", { name: "phone", size: 19 }) %>
                                <span>ติดต่อเรา</span>
                            </button>
                            <button class="about-help-tab is-active" id="about-tab-about" type="button" role="tab" aria-selected="true" aria-controls="about-panel-about" data-about-tab="about">
                                <%- include("./partials/tabler-icon", { name: "receipt", size: 19 }) %>
                                <span>เกี่ยวกับเรา</span>
                            </button>
                        </div>
                    </aside>

                    <div class="about-help-content">
                        <section class="about-help-panel" id="about-panel-about" role="tabpanel" aria-labelledby="about-tab-about" data-about-panel="about">
                            <div class="about-help-heading">
                                <span class="about-help-heading-icon"><%- include("./partials/tabler-icon", { name: "receipt", size: 22 }) %></span>
                                <h1>เกี่ยวกับเรา</h1>
                            </div>

                            <div class="about-help-card">
                                <h2>UTK-Store ร้านค้าออนไลน์สำหรับชุมชนมหาวิทยาลัย</h2>
                                <p>UTK-Store ช่วยให้เลือกดูสินค้า ตรวจสอบรายละเอียดและตัวเลือกสินค้า ใส่สินค้าในตะกร้า และสั่งซื้อผ่านเว็บไซต์ได้สะดวกขึ้น</p>

                                <h3>ขั้นตอนการสั่งซื้อและนัดรับ</h3>
                                <ol class="about-pickup-steps">
                                    <li><strong>เลือกสินค้า</strong><span>เลือกสินค้าและ Variant ที่ต้องการ แล้วเพิ่มลงตะกร้า</span></li>
                                    <li><strong>ยืนยันคำสั่งซื้อ</strong><span>ตรวจสอบข้อมูลผู้ติดต่อ ชำระเงินตามช่องทางที่ร้านแจ้ง และแนบหลักฐานการชำระเงิน</span></li>
                                    <li><strong>รอร้านตรวจสอบ</strong><span>ติดตามสถานะคำสั่งซื้อในบัญชีของคุณ เมื่อร้านตรวจสอบแล้วจะยืนยันคำสั่งซื้อ</span></li>
                                    <li><strong>นัดรับสินค้าที่ร้าน</strong><span>ติดต่อร้านเพื่อนัดวัน เวลา และจุดรับสินค้า หลังรับสินค้าเรียบร้อย ร้านจะปิดคำสั่งซื้อเป็นสำเร็จ</span></li>
                                </ol>

                                <div class="about-pickup-note">
                                    <%- include("./partials/tabler-icon", { name: "map-pin", size: 20 }) %>
                                    <span>ระบบปัจจุบันรองรับการนัดรับที่ร้าน ยังไม่มีบริการจัดส่งถึงที่อยู่</span>
                                </div>
                            </div>
                        </section>

                        <section class="about-help-panel" id="about-panel-contact" role="tabpanel" aria-labelledby="about-tab-contact" data-about-panel="contact" hidden>
                            <div class="about-help-heading">
                                <span class="about-help-heading-icon"><%- include("./partials/tabler-icon", { name: "phone", size: 22 }) %></span>
                                <h1>ติดต่อเรา</h1>
                            </div>

                            <div class="about-help-card">
                                <div class="about-contact-intro">
                                    <div>
                                        <h2>สอบถามข้อมูลสินค้าและนัดรับ</h2>
                                        <p class="text-secondary mb-0">ติดต่อเราได้ตามช่องทางด้านล่าง ข้อมูลชุดนี้เป็นตัวอย่างสำหรับแก้ไขก่อนนำเว็บไปใช้งานจริง</p>
                                    </div>
                                    <span class="badge bg-yellow-lt">ข้อมูลตัวอย่าง</span>
                                </div>

                                <div class="about-contact-list">
                                    <div class="about-contact-item">
                                        <span class="about-contact-icon"><%- include("./partials/tabler-icon", { name: "phone", size: 20 }) %></span>
                                        <div><div class="text-secondary">โทรศัพท์</div><strong>02-123-4567</strong></div>
                                    </div>
                                    <div class="about-contact-item">
                                        <span class="about-contact-icon"><%- include("./partials/tabler-icon", { name: "mail", size: 20 }) %></span>
                                        <div><div class="text-secondary">อีเมล</div><strong>contact@utk-store.example</strong></div>
                                    </div>
                                    <div class="about-contact-item">
                                        <span class="about-contact-icon"><%- include("./partials/tabler-icon", { name: "map-pin", size: 20 }) %></span>
                                        <div><div class="text-secondary">จุดนัดรับ</div><strong>บริเวณร้าน UTK-Store ภายในมหาวิทยาลัย</strong></div>
                                    </div>
                                    <div class="about-contact-item">
                                        <span class="about-contact-icon"><%- include("./partials/tabler-icon", { name: "clock", size: 20 }) %></span>
                                        <div><div class="text-secondary">เวลาติดต่อ</div><strong>วันจันทร์–ศุกร์ เวลา 09:00–16:00 น.</strong></div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </main>

        <script>
            (() => {
                const tabs = [...document.querySelectorAll("[data-about-tab]")];
                const panels = [...document.querySelectorAll("[data-about-panel]")];
                const activate = (name, updateHash = true) => {
                    tabs.forEach((tab) => {
                        const active = tab.dataset.aboutTab === name;
                        tab.classList.toggle("is-active", active);
                        tab.setAttribute("aria-selected", String(active));
                        tab.tabIndex = active ? 0 : -1;
                    });
                    panels.forEach((panel) => { panel.hidden = panel.dataset.aboutPanel !== name; });
                    if (updateHash) history.replaceState(null, "", `#${name}`);
                };

                tabs.forEach((tab, index) => {
                    tab.addEventListener("click", () => activate(tab.dataset.aboutTab));
                    tab.addEventListener("keydown", (event) => {
                        if (!["ArrowDown", "ArrowUp", "ArrowLeft", "ArrowRight"].includes(event.key)) return;
                        event.preventDefault();
                        const step = ["ArrowDown", "ArrowRight"].includes(event.key) ? 1 : -1;
                        const next = tabs[(index + step + tabs.length) % tabs.length];
                        next.focus();
                        activate(next.dataset.aboutTab);
                    });
                });

                const initialTab = window.location.hash === "#contact" ? "contact" : "about";
                activate(initialTab, false);
            })();
        </script>
        <script src="/js/tabler.min.js"></script>
        <%- include("./partials/store-footer") %>
    </body>
</html>
