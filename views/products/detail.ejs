<!DOCTYPE html>
<html lang="th">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title><%= product.name %> | UTK-Store</title>

    <link
        rel="stylesheet"
        href="/css/tabler.min.css"
    >

    <!-- CSS ของเรา -->
    <link
        rel="stylesheet"
        href="/css/style.css"
    >
    

</head>


<body>


    <!-- ========================= -->
    <!-- Navbar -->
    <!-- ========================= -->

    <header class="navbar navbar-expand-md d-print-none">

        <div class="container-xl">

            <a
                href="/"
                class="navbar-brand navbar-brand-autodark"
            >
                UTK-Store
            </a>


            <div class="navbar-nav flex-row order-md-last ms-auto">

                <a
                    href="/products"
                    class="btn btn-outline-secondary me-2"
                >
                    ← สินค้า
                </a>

                <a
                    href="/cart"
                    class="btn btn-primary"
                >
                    🛒 รถเข็น
                </a>

            </div>

        </div>

    </header>



    <!-- ========================= -->
    <!-- Page -->
    <!-- ========================= -->

    <div class="page">

        <div class="page-wrapper">


            <!-- Page Header -->

            <div class="page-header d-print-none">

                <div class="container-xl">

                    <div class="row align-items-center">

                        <div class="col">

                            <h2 class="page-title">
                                รายละเอียดสินค้า
                            </h2>

                            <div class="text-secondary mt-1">
                                ดูรายละเอียดและเลือกตัวเลือกสินค้า
                            </div>

                        </div>

                    </div>

                </div>

            </div>



            <!-- Page Body -->

            <div class="page-body">

                <div class="container-xl">

                    <div class="row row-cards">


                        <!-- ========================= -->
                        <!-- Product Image -->
                        <!-- ========================= -->

                        <div class="col-lg-5">

                            <div class="card">

                                <div class="card-body p-3">

                                    <% if (product.image_path) { %>

                                        <img
                                            src="<%= product.image_path %>"
                                            class="w-100 rounded"
                                            style="
                                                height: 420px;
                                                object-fit: cover;
                                            "
                                            alt="<%= product.name %>"
                                        >

                                    <% } else { %>

                                        <div
                                            class="d-flex align-items-center justify-content-center bg-secondary-lt rounded"
                                            style="
                                                height: 420px;
                                            "
                                        >

                                            <span class="text-secondary">
                                                ไม่มีรูปสินค้า
                                            </span>

                                        </div>

                                    <% } %>

                                </div>

                            </div>

                        </div>



                        <!-- ========================= -->
                        <!-- Product Information -->
                        <!-- ========================= -->

                        <div class="col-lg-7">

                            <div class="card h-100">

                                <div class="card-body">


                                    <!-- Category -->

                                    <div class="mb-3">

                                        <span class="badge bg-blue-lt">

                                            <%= product.category_name %>

                                        </span>

                                    </div>



                                    <!-- Name -->

                                    <h1 class="mb-2">

                                        <%= product.name %>

                                    </h1>



                                    <!-- Code -->

                                    <div class="text-secondary mb-4">

                                        รหัสสินค้า:
                                        <span class="fw-medium">
                                            <%= product.code %>
                                        </span>

                                    </div>



                                    <!-- Price -->

                                    <div class="mb-4">

                                        <div class="text-secondary small">
                                            ราคา
                                        </div>

                                        <div class="h1 mb-0 text-primary">

                                            <%= Number(product.price).toLocaleString("th-TH", {
                                                minimumFractionDigits: 2,
                                                maximumFractionDigits: 2
                                            }) %>

                                            <span class="fs-3">
                                                บาท
                                            </span>

                                        </div>

                                    </div>



                                    <!-- Description -->

                                    <div class="mb-4">

                                        <h3>
                                            รายละเอียดสินค้า
                                        </h3>

                                        <div class="text-secondary">

                                            <%= product.description || "ไม่มีรายละเอียดสินค้า" %>

                                        </div>

                                    </div>



                                    <hr>



                                    <!-- ========================= -->
                                    <!-- Add To Cart -->
                                    <!-- ========================= -->

                                    <form
                                        action="/cart/add"
                                        method="POST"
                                    >


                                        <input
                                            type="hidden"
                                            name="returnTo"
                                            value="/products/<%= product.product_id %>"
                                        >



                                        <!-- Variants -->

                                        <div class="mb-4">

                                            <h3 class="mb-3">
                                                ตัวเลือกสินค้า
                                            </h3>


                                            <% if (product.variants.length === 0) { %>

                                                <div class="alert alert-warning">

                                                    สินค้านี้ยังไม่มีตัวเลือกสินค้า

                                                </div>

                                            <% } else { %>


                                                <div
                                                    id="variant-selector"
                                                    data-variants='<%= JSON.stringify(product.variants) %>'
                                                >



                                                            <!-- Size -->

                                                            <%
                                                                const sizes = [
                                                                    ...new Set(
                                                                        product.variants
                                                                            .map(v => v.size)
                                                                            .filter(Boolean)
                                                                    )
                                                                ];
                                                            %>

                                                            <% if (sizes.length > 0) { %>

                                                                <div class="mb-3">

                                                                    <label class="form-label">
                                                                        Size
                                                                    </label>

                                                                    <div class="d-flex flex-wrap gap-2">

                                                                        <% sizes.forEach(size => { %>

                                                                            <button
                                                                                type="button"
                                                                                class="btn btn-outline-primary size-btn"
                                                                                data-size="<%= size %>"
                                                                           >
                                                                                <%= size %>
                                                                            </button>

                                                                        <% }) %>
                                                            
                                                                    </div>

                                                                </div>

                                                            <% } %>

                                                            <!-- Color -->

                                                            <%
                                                                const colors = [
                                                                    ...new Set(
                                                                        product.variants
                                                                            .map(v => v.color)
                                                                            .filter(Boolean)
                                                                    )
                                                                ];
                                                            %>

                                                            <% if (colors.length > 0) { %>

                                                                <div class="mb-3">

                                                                    <label class="form-label">
                                                                        Color
                                                                    </label>

                                                                    <div class="d-flex flex-wrap gap-2">

                                                                        <% colors.forEach(color => { %>

                                                                            <button
                                                                                type="button"
                                                                                class="btn btn-outline-warning color-btn"
                                                                                data-color="<%= color %>"
                                                                           >
                                                                                <%= color %>
                                                                            </button>

                                                                        <% }) %>
                                                            
                                                                    </div>

                                                                </div>

                                                            <% } %>









                                                    <!-- <table class="table table-vcenter card-table">

                                                        <thead>

                                                            <tr>

                                                                <th>
                                                                    เลือก
                                                                </th>

                                                                <th>
                                                                    Size
                                                                </th>

                                                                <th>
                                                                    Color
                                                                </th>

                                                                <th class="text-end">
                                                                    Stock
                                                                </th>

                                                            </tr>

                                                        </thead>


                                                        <tbody>

                                                            <% product.variants.forEach(variant => { %>

                                                                <tr>

                                                                    <td>

                                                                        <label
                                                                            class="form-check"
                                                                        >

                                                                            <input
                                                                                class="form-check-input"
                                                                                type="radio"
                                                                                name="variant_id"
                                                                                value="<%= variant.variant_id %>"
                                                                                <%= variant.stock <= 0 ? "disabled" : "" %>
                                                                                required
                                                                            >

                                                                        </label>

                                                                    </td>


                                                                    <td>

                                                                        <%= variant.size || "-" %>

                                                                    </td>


                                                                    <td>

                                                                        <%= variant.color || "-" %>

                                                                    </td>


                                                                    <td class="text-end">

                                                                        <% if (variant.stock > 0) { %>

                                                                            <span class="badge bg-green-lt">

                                                                                <%= variant.stock %>

                                                                            </span>

                                                                        <% } else { %>

                                                                            <span class="badge bg-red-lt">

                                                                                หมด

                                                                            </span>

                                                                        <% } %>

                                                                    </td>

                                                                </tr>

                                                            <% }) %>

                                                        </tbody>

                                                    </table> -->

                                                </div>


                                            <% } %>

                                        </div>



                                        <!-- Quantity -->

                                        <div class="mb-4">

                                            <label class="form-label">
                                                จำนวน
                                            </label>

                                            
                                            <div class="d-flex align-items-center gap-1">

                                                <!-- Quantity -->
                                                <input
                                                    type="number"
                                                    name="quantity"
                                                    id="quantity"
                                                    class="form-control"
                                                    value="1"
                                                    min="1"
                                                    style="max-width: 150px;"
                                                    required
                                                >

                                                <!-- Stock -->
                                                <div id="variant-stock" class="mb-2 ms-2 d-none">
                                                    <span class="text-secondary">
                                                        Stock:
                                                    </span>
                                                    <span id="stock-value" class="fw-bold"></span>
                                                </div>
                                            </div>
                                        </div>



                                        <!-- Buttons -->

                                        <div class="d-flex gap-2">


                                            <% if (product.variants.length > 0) { %>

                                                <input
                                                    type="hidden"
                                                    name="variant_id"
                                                    id="selected-variant-id"
                                                    required
                                                >


                                                <button
                                                    type="submit"
                                                    class="btn btn-primary"
                                                    id="add-to-cart-btn"
                                                    disabled
                                                >

                                                    🛒 เพิ่มลงตะกร้า

                                                </button>

                                            <% } %>


                                            <a
                                                href="/products"
                                                class="btn btn-outline-secondary"
                                            >

                                                ← กลับไปหน้าสินค้า

                                            </a>


                                        </div>


                                    </form>

                                </div>

                            </div>

                        </div>


                    </div>


                    <!-- ========================= -->
                    <!-- Product Status -->
                    <!-- ========================= -->

                    <div class="row row-cards mt-3">

                        <div class="col-12">

                            <div class="card">

                                <div class="card-body">

                                    <div class="d-flex align-items-center">


                                        <span
                                            class="avatar
                                            <%= product.status === 'ACTIVE'
                                                ? 'bg-green-lt'
                                                : 'bg-red-lt'
                                            %>
                                            me-3"
                                        >

                                            <%= product.status === "ACTIVE"
                                                ? "✓"
                                                : "!"
                                            %>

                                        </span>


                                        <div>

                                            <div class="fw-bold">
                                                สถานะสินค้า
                                            </div>

                                            <div class="text-secondary">

                                                <% if (product.status === "ACTIVE") { %>

                                                    สินค้านี้พร้อมสำหรับการสั่งซื้อ

                                                <% } else { %>

                                                    สินค้านี้ไม่เปิดให้สั่งซื้อ

                                                <% } %>

                                            </div>

                                        </div>


                                        <div class="ms-auto">

                                            <% if (product.status === "ACTIVE") { %>

                                                <span class="badge bg-green-lt">
                                                    พร้อมขาย
                                                </span>

                                            <% } else { %>

                                                <span class="badge bg-red-lt">
                                                    ไม่พร้อมขาย
                                                </span>

                                            <% } %>

                                        </div>


                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                </div>

            </div>


        </div>

    </div>



    <!-- Tabler JS -->

    <script src="/js/tabler.min.js"></script>

    <script>

        // ========================================
        // ตัวแปรเก็บ Size และ Color ที่ผู้ใช้เลือก
        // ========================================

        let selectedSize = null;
        let selectedColor = null;


        // ========================================
        // ดึงข้อมูล Variant จาก EJS
        // ========================================

        const variantSelector = document.querySelector("#variant-selector");

        const variants = JSON.parse(variantSelector.dataset.variants);


        // ========================================
        // ดึงปุ่ม Size และ Color
        // ========================================

        const sizeButtons =
            document.querySelectorAll(".size-btn");

        const colorButtons =
            document.querySelectorAll(".color-btn");


        // ========================================
        // ดึง Element ที่ใช้ในระบบ
        // ========================================

        const stockBox = document.querySelector("#variant-stock");
        const stockValue = document.querySelector("#stock-value");
        const addToCartButton = document.querySelector("#add-to-cart-btn");
        const selectedVariantInput = document.querySelector("#selected-variant-id");
        const quantityInput = document.querySelector("#quantity");


        // ========================================
        // หา Variant จาก Size + Color ที่เลือก
        // ========================================

        function findSelectedVariant() {

            // เช็กว่าสินค้านี้มี Size หรือไม่
            const hasSize =
                sizeButtons.length > 0;

            // เช็กว่าสินค้านี้มี Color หรือไม่
            const hasColor =
                colorButtons.length > 0;


            // ถ้ามี Size แต่ยังไม่ได้เลือก
            if (hasSize && !selectedSize) {
                return null;
             }


            // ถ้ามี Color แต่ยังไม่ได้เลือก
            if (hasColor && !selectedColor) {
                return null;
            }


            // ค้นหา Variant ที่ตรงกับตัวเลือก
            const variant = variants.find(v => {

                // ถ้าไม่มี Size ให้ผ่าน
                // ถ้ามี Size ต้องตรงกับที่เลือก
                const sizeMatch =
                    !hasSize ||
                    v.size === selectedSize;


                // ถ้าไม่มี Color ให้ผ่าน
                // ถ้ามี Color ต้องตรงกับที่เลือก
                const colorMatch =
                    !hasColor ||
                    v.color === selectedColor;


                // ต้องตรงทั้ง Size และ Color
                return sizeMatch && colorMatch;
            });


            // แสดง Variant ที่หาได้ใน Console
            console.log(
                "Variant ที่เลือก:",
                variant
            );


            return variant;
        }


        // ========================================
        // Update Stock
        // ========================================

        function updateStock() {

            // หา Variant ที่ตรงกับที่เลือก
            const variant =
                findSelectedVariant();


            // ------------------------------------
            // ถ้ายังเลือก Variant ไม่ครบ
            // ------------------------------------

            if (!variant) {

                // ซ่อน Stock
                stockBox.classList.add("d-none");

                // ล้างตัวเลข Stock
                stockValue.textContent = "";

                // ปิดปุ่มเพิ่มลงตะกร้า
                addToCartButton.disabled = true;

                // ล้าง Variant ID
                selectedVariantInput.value = "";

                // ล้าง Max ของ Quantity
                quantityInput.removeAttribute("max");

                return;
            }


            // ------------------------------------
            // ถ้ามี Variant แล้ว
            // ------------------------------------

            // ใส่ Variant ID ลง Hidden Input
            selectedVariantInput.value =
                variant.variant_id;


            // กำหนดจำนวนสูงสุดตาม Stock
            quantityInput.max =
                variant.stock;


            // ถ้าจำนวนที่กรอกอยู่มากกว่า Stock
            // ให้ปรับกลับมาเท่ากับ Stock
            if (
                Number(quantityInput.value) > variant.stock
            ) {
                quantityInput.value = variant.stock;
            }


            // ถ้า Stock หมด
            // ปิดปุ่มเพิ่มตะกร้า
            if (variant.stock <= 0) {

                addToCartButton.disabled = true;

            } else {

                // ถ้ามี Stock
                // เปิดปุ่มเพิ่มตะกร้า
                addToCartButton.disabled = false;
            }


            // แสดงกล่อง Stock
            stockBox.classList.remove("d-none");


            // แสดงจำนวน Stock
            stockValue.textContent =
                variant.stock;
        }


        // ========================================
        // เมื่อกดปุ่ม Size
        // ========================================

        sizeButtons.forEach(button => {

            button.addEventListener(
                "click",
                function () {

                    // ถ้ากดปุ่มเดิมที่กำลัง Active
                    // ให้ยกเลิกการเลือก
                    if (
                        this.classList.contains("active")
                    ) {

                        this.classList.remove("active");

                        selectedSize = null;

                    } else {

                        // เอา Active ออกจากปุ่ม Size อื่น
                        sizeButtons.forEach(btn => {

                            btn.classList.remove("active");

                        });


                        // ทำปุ่มที่กดให้ Active
                        this.classList.add("active");


                        // เก็บค่าที่เลือก
                        selectedSize =
                            this.dataset.size;
                    }


                // อัปเดต Variant และ Stock
                updateStock();
            }
        );

    });


    // ========================================
    // เมื่อกดปุ่ม Color
    // ========================================

    colorButtons.forEach(button => {

        button.addEventListener(
            "click",
            function () {

                // ถ้ากดปุ่มเดิมที่กำลัง Active
                // ให้ยกเลิกการเลือก
                if (
                    this.classList.contains("active")
                ) {

                    this.classList.remove("active");

                    selectedColor = null;

                } else {

                    // เอา Active ออกจาก Color อื่น
                    colorButtons.forEach(btn => {

                        btn.classList.remove("active");

                    });


                    // ทำปุ่มที่กดให้ Active
                    this.classList.add("active");


                    // เก็บค่าที่เลือก
                    selectedColor =
                        this.dataset.color;
                }


                // อัปเดต Variant และ Stock
                updateStock();
            }
        );

    });


    // ========================================
    // ป้องกันกรอกจำนวนเกิน Stock
    // ========================================

    quantityInput.addEventListener(
        "input",
        function () {

            // หา Variant ปัจจุบัน
            const variant =
                findSelectedVariant();


            // ถ้ายังไม่ได้เลือก Variant
            // ไม่ต้องทำอะไร
            if (!variant) {
                return;
            }


            // ถ้ากรอกมากกว่า Stock
            // ให้ปรับกลับมาเป็น Stock
            if (
                Number(this.value) >
                variant.stock
            ) {

                this.value =
                    variant.stock;
            }


            // ถ้ากรอกน้อยกว่า 1
            // ให้กลับเป็น 1
            if (
                Number(this.value) < 1
            ) {

                this.value = 1;
            }

        }
    );

        // ========================================
        // โหลดข้อมูล Stock ตอนเปิดหน้า
        // สำหรับสินค้าที่ไม่มี Size / Color
        // ========================================

        updateStock();

    </script>



</body>

</html>