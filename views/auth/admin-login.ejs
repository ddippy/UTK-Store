<!DOCTYPE html>
<html lang="th">
    <head>
        <meta charset="UTF-8" />

        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>Admin Login | UTK-Store</title>

        <link rel="stylesheet" href="/css/tabler.min.css" />

        <link rel="stylesheet" href="/css/style.css" />
    </head>

    <body class="bg-light">
        <main class="admin-login-page">
            <div class="container container-tight py-4">
                <div class="text-center mb-4">
                    <div class="fw-bold text-danger" style="font-size: 32px">UTK-Store</div>

                    <div class="text-secondary mt-1">ระบบจัดการสำหรับผู้ดูแลระบบ</div>
                </div>

                <!-- Login Card -->

                <div class="card card-md">
                    <div class="card-body p-4">
                        <h2 class="h2 text-center mb-4 text-danger">Admin Login</h2>

                        <% if (error) { %>

                        <div class="alert alert-danger" role="alert">
                            <div>
                                <h4 class="alert-title">เข้าสู่ระบบไม่สำเร็จ</h4>

                                <div class="text-secondary"><%= error %></div>
                            </div>
                        </div>

                        <% } %>

                        <form action="/admin/login" method="POST">
                            <input type="hidden" name="returnTo" value="<%= returnTo %>" />

                            <!-- Username -->

                            <div class="mb-3">
                                <label class="form-label"> Username </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    name="username"
                                    placeholder="กรอก Admin Username"
                                    autocomplete="username"
                                    required
                                />
                            </div>

                            <!-- Password -->

                            <div class="mb-3">
                                <label class="form-label"> Password </label>

                                <input
                                    type="password"
                                    class="form-control"
                                    name="password"
                                    placeholder="กรอก Password"
                                    autocomplete="current-password"
                                    required
                                />
                            </div>

                            <!-- Login Button -->

                            <div class="form-footer">
                                <button class="btn btn-danger w-100" type="submit">
                                    เข้าสู่ระบบ
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- User Login -->

                    <div class="card-footer text-center">
                        <div class="text-secondary mb-2">สำหรับผู้ใช้งานทั่วไป</div>

                        <a href="/user/login" class="btn btn-outline-primary w-100">
                            เข้าสู่ระบบผู้ใช้
                        </a>
                    </div>
                </div>

                <div class="text-center text-secondary mt-3">UTK-Store Admin</div>
            </div>
        </main>

        <script src="/js/tabler.min.js"></script>
    </body>
</html>
