<!DOCTYPE html>
<html lang="th">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>เพิ่มสินค้า | Admin</title>

    <link rel="stylesheet" href="/css/tabler.min.css">

</head>

<body>

    <!-- Navbar -->
    <header class="navbar navbar-expand-md d-print-none">
        <div class="container-xl">

            <a
                href="/admin"
                class="navbar-brand navbar-brand-autodark"
            >
                UTK-Store Admin
            </a>

            <div class="navbar-nav flex-row order-md-last ms-auto">

                <a
                    href="/products"
                    class="btn btn-outline-primary"
                >
                    🛍️ หน้าร้าน
                </a>

            </div>

        </div>
    </header>


    <!-- Page -->
    <div class="page">

        <div class="page-wrapper">

            <!-- Page Header -->
            <div class="page-header d-print-none">

                <div class="container-xl">

                    <div class="row align-items-center">

                        <div class="col">

                            <h2 class="page-title">
                                เพิ่มสินค้า
                            </h2>

                            <div class="text-secondary mt-1">
                                เพิ่มสินค้าใหม่เข้าสู่ระบบร้านค้า
                            </div>

                        </div>

                        <div class="col-auto">

                            <a
                                href="/admin/products"
                                class="btn btn-outline-secondary"
                            >
                                ← กลับไปจัดการสินค้า
                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Page Body -->
            <div class="page-body">

                <div class="container-xl">

                    <div class="row row-cards">

                        <!-- Product Form -->
                        <div class="col-lg-8">

                            <form
                                action="/admin/products/create"
                                method="POST"
                                enctype="multipart/form-data"
                            >

                                <div class="card">

                                    <div class="card-header">

                                        <h3 class="card-title">
                                            ข้อมูลสินค้า
                                        </h3>

                                    </div>


                                    <div class="card-body">

                                        <!-- Product Code -->
                                        <div class="mb-3">

                                            <label class="form-label">

                                                รหัสสินค้า

                                                <span class="text-danger">
                                                    *
                                                </span>

                                            </label>

                                            <input
                                                type="text"
                                                name="code"
                                                class="form-control"
                                                placeholder="เช่น P001"
                                                required
                                            >

                                        </div>


                                        <!-- Product Name -->
                                        <div class="mb-3">

                                            <label class="form-label">

                                                ชื่อสินค้า

                                                <span class="text-danger">
                                                    *
                                                </span>

                                            </label>

                                            <input
                                                type="text"
                                                name="name"
                                                class="form-control"
                                                placeholder="เช่น เสื้อ UTK"
                                                required
                                            >

                                        </div>


                                        <!-- Category -->
                                        <div class="mb-3">

                                            <label class="form-label">

                                                หมวดหมู่

                                                <span class="text-danger">
                                                    *
                                                </span>

                                            </label>

                                            <select
                                                name="category_id"
                                                class="form-select"
                                                required
                                            >

                                                <option value="">
                                                    -- เลือกหมวดหมู่ --
                                                </option>

                                                <% categories.forEach(category => { %>

                                                    <option
                                                        value="<%= category.category_id %>"
                                                    >
                                                        <%= category.name %>
                                                    </option>

                                                <% }) %>

                                            </select>

                                        </div>


                                        <!-- Price -->
                                        <div class="mb-3">

                                            <label class="form-label">

                                                ราคา

                                                <span class="text-danger">
                                                    *
                                                </span>

                                            </label>

                                            <div class="input-group">

                                                <input
                                                    type="number"
                                                    name="price"
                                                    class="form-control"
                                                    min="0"
                                                    step="0.01"
                                                    placeholder="0.00"
                                                    required
                                                >

                                                <span class="input-group-text">
                                                    บาท
                                                </span>

                                            </div>

                                        </div>


                                        <!-- Image -->
                                        <div class="mb-3">

                                            <label class="form-label">
                                                รูปสินค้า
                                            </label>

                                            <input
                                                type="file"
                                                name="image"
                                                class="form-control"
                                                accept="image/*"
                                            >

                                            <div class="form-hint">
                                                เลือกรูปภาพสำหรับแสดงในหน้าร้าน
                                            </div>

                                        </div>


                                        <!-- Description -->
                                        <div class="mb-3">

                                            <label class="form-label">
                                                รายละเอียด
                                            </label>

                                            <textarea
                                                name="description"
                                                class="form-control"
                                                rows="6"
                                                placeholder="รายละเอียดสินค้า..."
                                            ></textarea>

                                        </div>

                                    </div>


                                    <!-- Footer -->
                                    <div class="card-footer d-flex justify-content-between">

                                        <a
                                            href="/admin/products"
                                            class="btn btn-outline-secondary"
                                        >
                                            ยกเลิก
                                        </a>


                                        <button
                                            type="submit"
                                            class="btn btn-primary"
                                        >
                                            + เพิ่มสินค้า
                                        </button>

                                    </div>

                                </div>

                            </form>

                        </div>


                        <!-- Information -->
                        <div class="col-lg-4">

                            <!-- Info Card -->
                            <div class="card">

                                <div class="card-header">

                                    <h3 class="card-title">
                                        ข้อมูลเพิ่มเติม
                                    </h3>

                                </div>


                                <div class="card-body">

                                    <div class="d-flex mb-4">

                                        <span class="avatar bg-blue-lt me-3">
                                            📝
                                        </span>

                                        <div>

                                            <div class="fw-bold">
                                                ข้อมูลสินค้า
                                            </div>

                                            <div class="text-secondary mt-1">
                                                กรอกรหัส ชื่อ หมวดหมู่
                                                และราคาของสินค้า
                                            </div>

                                        </div>

                                    </div>


                                    <div class="d-flex mb-4">

                                        <span class="avatar bg-green-lt me-3">
                                            💰
                                        </span>

                                        <div>

                                            <div class="fw-bold">
                                                ราคา
                                            </div>

                                            <div class="text-secondary mt-1">
                                                สามารถใส่ราคาเป็นทศนิยมได้
                                            </div>

                                        </div>

                                    </div>


                                    <div class="d-flex mb-4">

                                        <span class="avatar bg-purple-lt me-3">
                                            🖼️
                                        </span>

                                        <div>

                                            <div class="fw-bold">
                                                รูปสินค้า
                                            </div>

                                            <div class="text-secondary mt-1">
                                                สามารถอัปโหลดรูปสินค้า
                                                เพื่อแสดงในหน้าร้านได้
                                            </div>

                                        </div>

                                    </div>


                                    <div class="d-flex">

                                        <span class="avatar bg-yellow-lt me-3">
                                            📦
                                        </span>

                                        <div>

                                            <div class="fw-bold">
                                                Variant
                                            </div>

                                            <div class="text-secondary mt-1">
                                                หลังจากสร้างสินค้าแล้ว
                                                สามารถเพิ่ม Size, สี และ Stock
                                                ได้ในหน้า Variant
                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- Required Info -->
                            <div class="card mt-3">

                                <div class="card-body">

                                    <div class="d-flex align-items-center">

                                        <span class="avatar bg-red-lt me-3">
                                            *
                                        </span>

                                        <div>

                                            <div class="fw-bold">
                                                ช่องที่จำเป็น
                                            </div>

                                            <div class="text-secondary">
                                                ช่องที่มีเครื่องหมาย
                                                <span class="text-danger">*</span>
                                                ต้องกรอก
                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <script src="/js/tabler.min.js"></script>

</body>

</html>