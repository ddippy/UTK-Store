<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>แก้ไขสินค้า | Admin</title>
</head>

<body>

    <h1>แก้ไขสินค้า</h1>

    <form
        action="/admin/products/<%= product.product_id %>/edit"
        method="POST"
    >

        <label>รหัสสินค้า</label>
        <br>

        <input
            type="text"
            name="code"
            value="<%= product.code %>"
            required
        >

        <br><br>

        <label>ชื่อสินค้า</label>
        <br>

        <input
            type="text"
            name="name"
            value="<%= product.name %>"
            required
        >

        <br><br>

        <label>หมวดหมู่</label>
        <br>

        <input
            type="number"
            name="category_id"
            value="<%= product.category_id %>"
            required
        >

        <br><br>

        <label>ราคา</label>
        <br>

        <input
            type="number"
            name="price"
            value="<%= product.price %>"
            min="0"
            step="0.01"
            required
        >

        <br><br>

        <label>รายละเอียด</label>
        <br>

        <textarea
            name="description"
            rows="5"
        ><%= product.description || "" %></textarea>

        <br><br>

        <label>สถานะ</label>
        <br>

        <select name="status">

            <option
                value="ACTIVE"
                <%= product.status === "ACTIVE" ? "selected" : "" %>
            >
                ACTIVE
            </option>

            <option
                value="INACTIVE"
                <%= product.status === "INACTIVE" ? "selected" : "" %>
            >
                INACTIVE
            </option>

        </select>

        <br><br>

        <button type="submit">
            บันทึกการแก้ไข
        </button>

    </form>

    <br>

    <a href="/admin/products">
        ← กลับไปจัดการสินค้า
    </a>

</body>

</html>