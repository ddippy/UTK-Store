<!DOCTYPE html>
<html lang="th">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>แก้ไขสินค้า | Admin</title>

    <link rel="stylesheet" href="/css/tabler.min.css">

</head>


<body>

    <!-- Navbar -->

    <header class="navbar navbar-expand-md d-print-none">

        <div class="container-xl">

            <a
                href="/admin"
                class="navbar-brand navbar-brand-autodark"
            >
                UTK-Store Admin
            </a>


            <div class="navbar-nav flex-row order-md-last ms-auto">

                <a
                    href="/products"
                    class="btn btn-outline-primary"
                >
                    🛍️ หน้าร้าน
                </a>

            </div>

        </div>

    </header>


    <!-- Page -->

    <div class="page">

        <div class="page-wrapper">


            <!-- Page Header -->

            <div class="page-header d-print-none">

                <div class="container-xl">

                    <div class="row align-items-center">

                        <div class="col">

                            <h2 class="page-title">
                                แก้ไขสินค้า
                            </h2>

                            <div class="text-secondary mt-1">
                                แก้ไขข้อมูลสินค้าและรายละเอียด
                            </div>

                        </div>


                        <div class="col-auto">

                            <a
                                href="/admin/products"
                                class="btn btn-outline-secondary"
                            >
                                ← กลับไปจัดการสินค้า
                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Page Body -->

            <div class="page-body">

                <div class="container-xl">

                    <div class="row row-cards">


                        <!-- Product Form -->

                        <div class="col-lg-8">

                            <form
                                action="/admin/products/<%= product.product_id %>/edit"
                                method="POST"
                                enctype="multipart/form-data"
                            >

                                <div class="card">


                                    <div class="card-header">

                                        <h3 class="card-title">
                                            ข้อมูลสินค้า
                                        </h3>

                                    </div>


                                    <div class="card-body">


                                        <!-- Product Code -->

                                        <div class="mb-3">

                                            <label class="form-label">
                                                รหัสสินค้า
                                                <span class="text-danger">*</span>
                                            </label>

                                            <input
                                                type="text"
                                                name="code"
                                                class="form-control"
                                                value="<%= product.code %>"
                                                required
                                            >

                                        </div>


                                        <!-- Product Name -->

                                        <div class="mb-3">

                                            <label class="form-label">
                                                ชื่อสินค้า
                                                <span class="text-danger">*</span>
                                            </label>

                                            <input
                                                type="text"
                                                name="name"
                                                class="form-control"
                                                value="<%= product.name %>"
                                                required
                                            >

                                        </div>


                                        <!-- Category -->

                                        <div class="mb-3">

                                            <label class="form-label">
                                                หมวดหมู่
                                                <span class="text-danger">*</span>
                                            </label>

                                            <select
                                                name="category_id"
                                                class="form-select"
                                                required
                                            >

                                                <% categories.forEach(category => { %>

                                                    <option
                                                        value="<%= category.category_id %>"
                                                        <%= Number(product.category_id) === Number(category.category_id) ? "selected" : "" %>
                                                    >
                                                        <%= category.name %>
                                                    </option>

                                                <% }) %>

                                            </select>

                                        </div>


                                        <!-- Price -->

                                        <div class="mb-3">

                                            <label class="form-label">
                                                ราคา
                                                <span class="text-danger">*</span>
                                            </label>

                                            <div class="input-group">

                                                <input
                                                    type="number"
                                                    name="price"
                                                    class="form-control"
                                                    value="<%= product.price %>"
                                                    min="0"
                                                    step="0.01"
                                                    required
                                                >

                                                <span class="input-group-text">
                                                    บาท
                                                </span>

                                            </div>

                                        </div>


                                        <!-- Description -->

                                        <div class="mb-3">

                                            <label class="form-label">
                                                รายละเอียด
                                            </label>

                                            <textarea
                                                name="description"
                                                class="form-control"
                                                rows="6"
                                            ><%= product.description || "" %></textarea>

                                        </div>


                                        <!-- Status -->

                                        <div class="mb-3">

                                            <label class="form-label">
                                                สถานะ
                                            </label>

                                            <select
                                                name="status"
                                                class="form-select"
                                            >

                                                <option
                                                    value="ACTIVE"
                                                    <%= product.status === "ACTIVE" ? "selected" : "" %>
                                                >
                                                    ACTIVE
                                                </option>

                                                <option
                                                    value="INACTIVE"
                                                    <%= product.status === "INACTIVE" ? "selected" : "" %>
                                                >
                                                    INACTIVE
                                                </option>

                                            </select>

                                        </div>


                                        <!-- Image -->

                                        <div class="mb-3">

                                            <label class="form-label">
                                                เปลี่ยนรูปสินค้า
                                            </label>

                                            <input
                                                type="file"
                                                name="image"
                                                class="form-control"
                                                accept="image/*"
                                            >

                                            <div class="form-hint">
                                                หากไม่เลือกไฟล์ ระบบจะใช้รูปเดิม
                                            </div>

                                        </div>


                                    </div>


                                    <!-- Footer -->

                                    <div class="card-footer d-flex justify-content-between">

                                        <a
                                            href="/admin/products"
                                            class="btn btn-outline-secondary"
                                        >
                                            ยกเลิก
                                        </a>


                                        <button
                                            type="submit"
                                            class="btn btn-primary"
                                        >
                                            💾 บันทึกการแก้ไข
                                        </button>

                                    </div>


                                </div>

                            </form>

                        </div>


                        <!-- Product Preview -->

                        <div class="col-lg-4">

                            <div class="card">


                                <div class="card-header">

                                    <h3 class="card-title">
                                        รูปสินค้า
                                    </h3>

                                </div>


                                <div class="card-body text-center">


                                    <% if (product.image_path) { %>

                                        <img
                                            src="<%= product.image_path %>"
                                            class="img-fluid rounded"
                                            style="
                                                width: 100%;
                                                height: 260px;
                                                object-fit: cover;
                                            "
                                            alt="<%= product.name %>"
                                        >

                                    <% } else { %>

                                        <div
                                            class="empty"
                                            style="min-height: 260px;"
                                        >

                                            <div class="empty-img">
                                                🖼️
                                            </div>

                                            <p class="empty-title">
                                                ยังไม่มีรูปสินค้า
                                            </p>

                                            <p class="empty-subtitle text-secondary">
                                                สามารถเลือกรูปใหม่จากฟอร์มด้านซ้าย
                                            </p>

                                        </div>

                                    <% } %>


                                    <div class="mt-3 text-start">

                                        <div class="text-secondary">
                                            สินค้า
                                        </div>

                                        <div class="fw-bold">
                                            <%= product.name %>
                                        </div>

                                    </div>


                                    <div class="mt-3 text-start">

                                        <div class="text-secondary">
                                            รหัสสินค้า
                                        </div>

                                        <div>
                                            <%= product.code %>
                                        </div>

                                    </div>


                                </div>

                            </div>


                            <!-- Status Card -->

                            <div class="card mt-3">

                                <div class="card-body">

                                    <div class="d-flex align-items-center">

                                        <% if (product.status === "ACTIVE") { %>

                                            <span class="avatar bg-green-lt me-3">
                                                ✓
                                            </span>

                                            <div>

                                                <div class="fw-bold">
                                                    สินค้าเปิดใช้งาน
                                                </div>

                                                <div class="text-secondary">
                                                    ACTIVE
                                                </div>

                                            </div>

                                        <% } else { %>

                                            <span class="avatar bg-red-lt me-3">
                                                ×
                                            </span>

                                            <div>

                                                <div class="fw-bold">
                                                    สินค้าปิดใช้งาน
                                                </div>

                                                <div class="text-secondary">
                                                    INACTIVE
                                                </div>

                                            </div>

                                        <% } %>

                                    </div>

                                </div>

                            </div>


                        </div>


                    </div>

                </div>

            </div>

        </div>

    </div>


    <script src="/js/tabler.min.js"></script>

</body>

</html>