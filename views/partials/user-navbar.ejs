<header id="user-navbar" class="border-bottom bg-white user-navbar">

    <!-- แถวบน -->
    <div class="container py-3">

        <!-- แถวหลัก -->
        <div class="navbar-main">

            <div class="d-flex align-items-center gap-3">

            	<!-- Logo -->
                <a href="/" class="store-logo-link" aria-label="UTK-Store หน้าแรก">
                    <img src="/images/utk-logo.png" class="store-logo-navbar" alt="UTK-Store">
                </a>

            	<!-- Search -->
                <form action="/products" method="GET" class="flex-fill mx-4" role="search">

                	<div class="input-icon">

                        <button type="submit" class="input-icon-addon border-0 bg-transparent" aria-label="ค้นหา">
                        	<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-search">
	                        	<path stroke="none" d="M0 0h24v24H0z" fill="none" />
	                        	<path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
	                        	<path d="M21 21l-6 -6" />
                        	</svg>
                        </button>

                		<input
                            type="search"
                            name="search"
                            class="form-control rounded-pill"
                            placeholder="ค้นหาสินค้า"
                            aria-label="ค้นหาสินค้า"
                            value="<%= typeof search !== 'undefined' ? search : '' %>"
                            maxlength="100"
                		>
                	</div>

                </form>

        		<!-- Icons -->
<div class="d-flex gap-2">

    <!-- 1. ปุ่มสถานะคำสั่งซื้อ (Status) -->
    <% if (locals.isUserLoggedIn) { %>
        <!-- ล็อกอินแล้ว -> ไปหน้าคำสั่งซื้อ -->
        <a href="/orders/my-orders" class="btn btn-icon rounded-circle bg-light" title="สถานะคำสั่งซื้อ">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-progress-alert">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M10 20.777a8.942 8.942 0 0 1 -2.48 -.969" />
                <path d="M14 3.223a9.003 9.003 0 0 1 0 17.554" />
                <path d="M4.579 17.093a8.961 8.961 0 0 1 -1.227 -2.592" />
                <path d="M3.124 10.5c.16 -.95 .468 -1.85 .9 -2.675l.169 -.305" />
                <path d="M6.907 4.579a8.954 8.954 0 0 1 3.093 -1.356" />
                <path d="M12 8v4" />
                <path d="M12 16v.01" />
            </svg>
        </a>
    <% } else { %>
        <!-- ยังไม่ล็อกอิน -> เด้ง Modal ล็อกอิน -->
        <button type="button" class="btn btn-icon rounded-circle bg-light js-open-login-modal" data-login-return-to="/orders/my-orders" title="สถานะคำสั่งซื้อ">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-progress-alert">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M10 20.777a8.942 8.942 0 0 1 -2.48 -.969" />
                <path d="M14 3.223a9.003 9.003 0 0 1 0 17.554" />
                <path d="M4.579 17.093a8.961 8.961 0 0 1 -1.227 -2.592" />
                <path d="M3.124 10.5c.16 -.95 .468 -1.85 .9 -2.675l.169 -.305" />
                <path d="M6.907 4.579a8.954 8.954 0 0 1 3.093 -1.356" />
                <path d="M12 8v4" />
                <path d="M12 16v.01" />
            </svg>
        </button>
    <% } %>

    <!-- 2. ปุ่มเข้าสู่ระบบ (User) -->
    <% {
        const navbarRoleName = String(locals.role || "USER").toUpperCase();
        const navbarRoleClass = ({ ADMIN: "admin", MANAGER: "manager", STAFF: "staff", USER: "user" })[navbarRoleName] || "user";
        const navbarRoleLabel = ({ ADMIN: "ผู้ดูแลระบบ", MANAGER: "ผู้จัดการ", STAFF: "เจ้าหน้าที่", USER: "ผู้ใช้ทั่วไป" })[navbarRoleName] || navbarRoleName;
    %>
        <% if (locals.isUserLoggedIn) { %>
            <button
                type="button"
                class="btn btn-icon rounded-circle bg-light user-role-ring user-role-ring-<%= navbarRoleClass %>"
                title="ออกจากระบบ (<%= navbarRoleLabel %>)"
                aria-label="ออกจากระบบ บัญชีบทบาท <%= navbarRoleLabel %>"
                data-bs-toggle="modal"
                data-bs-target="#user-logout-modal"
            >
        <% } else { %>
            <button
                id="user-login-button"
                type="button"
                class="btn btn-icon rounded-circle bg-light js-open-login-modal"
                title="เข้าสู่ระบบ"
                aria-label="เข้าสู่ระบบ"
            >
        <% } %>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-user">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                    <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                </svg>
        <% if (locals.isUserLoggedIn) { %>
            </button>
        <% } else { %>
            </button>
        <% } %>
    <% } %>

    <!-- 3. ปุ่มตะกร้าสินค้า (Bag) -->
    <% if (locals.isUserLoggedIn) { %>
        <!-- ล็อกอินแล้ว -> ไปหน้าตะกร้า -->
        <a href="/cart" class="btn btn-icon rounded-circle bg-light" title="ตะกร้าสินค้า">	
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-shopping-bag">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M6.331 8h11.339a2 2 0 0 1 1.977 2.304l-1.255 8.152a3 3 0 0 1 -2.966 2.544h-6.852a3 3 0 0 1 -2.965 -2.544l-1.255 -8.152a2 2 0 0 1 1.977 -2.304" />
                <path d="M9 11v-5a3 3 0 0 1 6 0v5" />
            </svg>
        </a>
    <% } else { %>
        <!-- ยังไม่ล็อกอิน -> เด้ง Modal ล็อกอิน -->
        <button type="button" class="btn btn-icon rounded-circle bg-light js-open-login-modal" data-login-return-to="/cart" title="ตะกร้าสินค้า">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-shopping-bag">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M6.331 8h11.339a2 2 0 0 1 1.977 2.304l-1.255 8.152a3 3 0 0 1 -2.966 2.544h-6.852a3 3 0 0 1 -2.965 -2.544l-1.255 -8.152a2 2 0 0 1 1.977 -2.304" />
                <path d="M9 11v-5a3 3 0 0 1 6 0v5" />
            </svg>
        </button>
    <% } %>

</div>

        	</div>

    	</div>

    </div>

    <!-- เมนู -->
  	<div class="navbar-extra">

  		<!-- แถวล่าง -->
  		<div class="container pb-3">

    		<div class="d-flex justify-content-between align-items-center">

                <details class="store-category-dropdown">
                    <summary class="btn bg-light">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M4 15h16a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4" />
                            <path d="M12 4c3.783 0 6.953 2.133 7.786 5h-15.572c.833 -2.867 4.003 -5 7.786 -5" />
                            <path d="M5 12h14" />
                        </svg>
                        <span>หมวดหมู่สินค้า</span>
                        <svg class="store-category-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </summary>
                    <div class="store-category-menu">
                        <a href="/products" class="store-category-link">สินค้าทั้งหมด</a>
                        <% (locals.storeCategories || []).forEach(category => { %>
                            <a href="/products?category_id=<%= category.category_id %>" class="store-category-link"><%= category.name %></a>
                        <% }) %>
                        <% if (!(locals.storeCategories || []).length) { %>
                            <span class="store-category-empty">ยังไม่มีหมวดหมู่สินค้า</span>
                        <% } %>
                    </div>
                </details>

        		<nav class="d-flex gap-4">
            		<a href="/" class="text-dark text-decoration-none">หน้าแรก</a>
            		<a href="/products" class="text-dark text-decoration-none">สินค้า</a>
                    <% if (locals.isUserLoggedIn) { %>
                        <a href="<%= ["MANAGER", "STAFF"].includes(String(locals.role || "USER").toUpperCase()) ? "/admin/orders" : "/orders/my-orders" %>" class="text-dark text-decoration-none">คำสั่งซื้อ</a>
                    <% } else { %>
                        <a href="/orders/my-orders" class="text-dark text-decoration-none js-open-login-modal" data-login-return-to="/orders/my-orders">คำสั่งซื้อ</a>
                    <% } %>
            		<a href="/about" class="text-dark text-decoration-none">เกี่ยวกับเรา</a>
        		</nav>

            </div>

        </div>

    </div>

</header>

<script>
    document.addEventListener("click", (event) => {
        document.querySelectorAll(".store-category-dropdown[open]").forEach((menu) => {
            if (!menu.contains(event.target)) menu.open = false;
        });
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            document.querySelectorAll(".store-category-dropdown[open]").forEach((menu) => {
                menu.open = false;
            });
        }
    });
</script>


<!-- เพิ่มตัวจองพื้นที่ไว้ใต้ Navbar -->
<div class="user-navbar-spacer"></div>


<div
    class="modal modal-blur fade"
    id="user-login-modal"
    tabindex="-1"
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content user-login-modal-content">

            <!-- ปุ่มปิด -->
            <button
                type="button"
                class="btn-close user-login-close"
                data-bs-dismiss="modal"
                aria-label="Close"
            ></button>

            <form
				id="user-login-form"
    			action="/user/login"
    			method="POST"
			>

                <div class="user-login-body">

                    <!-- หัวข้อ -->
                    <h2 class="user-login-title">
                        เข้าสู่ระบบ
                    </h2>

                    <!-- Return URL -->
                    <input
                        type="hidden"
                        name="returnTo"
                        id="login-return-to"
                    >

                    <!-- Username -->
                    <div class="user-login-input">
                        <span class="user-login-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-at">
								<path stroke="none" d="M0 0h24v24H0z" fill="none" />
								<path d="M8 12a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
								<path d="M16 12v1.5a2.5 2.5 0 0 0 5 0v-1.5a9 9 0 1 0 -5.5 8.28" />
							</svg>
                        </span>

                        <input
                            type="text"
                            name="username"
                            placeholder="อีเมล"
                            autocomplete="username"
                        >
                    </div>

                    <!-- Password -->
                    <div class="user-login-input">
                        <span class="user-login-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-key">
								<path stroke="none" d="M0 0h24v24H0z" fill="none" />
								<path d="M16.555 3.843l3.602 3.602a2.877 2.877 0 0 1 0 4.069l-2.643 2.643a2.877 2.877 0 0 1 -4.069 0l-.301 -.301l-6.558 6.558a2 2 0 0 1 -1.239 .578l-.175 .008h-1.172a1 1 0 0 1 -.993 -.883l-.007 -.117v-1.172a2 2 0 0 1 .467 -1.284l.119 -.13l.414 -.414h2v-2h2v-2l2.144 -2.144l-.301 -.301a2.877 2.877 0 0 1 0 -4.069l2.643 -2.643a2.877 2.877 0 0 1 4.069 0" />
								<path d="M15 9h.01" />
							</svg>
                        </span>

                        <input
                            type="password"
                            name="password"
                            placeholder="รหัสผ่าน"
                            autocomplete="current-password"
                        >
                    </div>

                    <!-- Login -->
                    <button
                        type="submit"
                        class="btn btn-primary user-login-submit"
                    >
                        เข้าสู่ระบบ
                    </button>

                    <!-- Register -->
                    <div class="user-login-register">
                        ยังไม่มีบัญชี?
                        <a href="/user/register">
                            สมัครสมาชิก
                        </a>
                    </div>

                </div>

            </form>

        </div>
    </div>
</div>

<% if (locals.isUserLoggedIn) { %>
<div class="modal modal-blur fade" id="user-logout-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-3">ออกจากระบบ</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
            </div>
            <div class="modal-body">
                ต้องการออกจากระบบใช่หรือไม่?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                <form action="/logout" method="POST">
                    <button type="submit" class="btn btn-danger">ออกจากระบบ</button>
                </form>
            </div>
        </div>
    </div>
</div>
<% } %>

<script src="/js/bootstrap.bundle.min.js"></script>

<script>
    const navbar = document.getElementById("user-navbar");

    function updateNavbar() {
        if (window.scrollY > 80) {
            navbar.classList.add("scrolled");
        } else if (window.scrollY < 10) {
            navbar.classList.remove("scrolled");
        }
    }

    updateNavbar();

    window.addEventListener("scroll", updateNavbar, {
        passive: true
    });

    window.addEventListener("pageshow", updateNavbar);

	const loginReturnTo = document.getElementById("login-return-to");
    const loginModalElement = document.getElementById("user-login-modal");
    const loginForm = document.querySelector("#user-login-form");
    let pendingProtectedForm = null;
    let requestedLoginReturnTo = null;

    const currentPageUrl = () => window.location.pathname + window.location.search;
    const openLoginModal = (returnTo) => {
        requestedLoginReturnTo = returnTo || currentPageUrl();
        if (!loginModalElement || !window.bootstrap?.Modal) return;
        window.bootstrap.Modal.getOrCreateInstance(loginModalElement).show();
    };

    if (loginModalElement && loginReturnTo) {
        loginModalElement.addEventListener("show.bs.modal", (event) => {
            const triggerReturnTo = event.relatedTarget?.getAttribute("data-login-return-to");
            loginReturnTo.value = requestedLoginReturnTo || triggerReturnTo || currentPageUrl();
            requestedLoginReturnTo = null;
        });

        loginModalElement.addEventListener("hidden.bs.modal", () => {
            pendingProtectedForm = null;
        });
    }

    document.addEventListener("click", (event) => {
        const loginTrigger = event.target.closest?.(".js-open-login-modal");
        if (!loginTrigger) return;

        event.preventDefault();
        openLoginModal(
            loginTrigger.getAttribute("data-login-return-to") || currentPageUrl(),
        );
    });

    window.openStoreLoginModal = (returnTo, formToResume = null) => {
        pendingProtectedForm = formToResume;
        openLoginModal(returnTo || currentPageUrl());
        loginForm?.elements.username?.focus();
    };

if (loginForm) {

    loginForm.addEventListener("submit", async function (e) {

        e.preventDefault();

        const usernameInput = loginForm.elements.username;
        const passwordInput = loginForm.elements.password;

        // ล้างกรอบแดง
        usernameInput.classList.remove("is-invalid");
        passwordInput.classList.remove("is-invalid");

        const formData = new URLSearchParams(
    		new FormData(loginForm)
		);

        try {

            const response = await fetch("/user/login", {
                method: "POST",
                body: formData,
                headers: {
                    "Accept": "application/json"
                }
            });

            const result = await response.json();

            // Login ผิด
            if (!response.ok) {

                usernameInput.classList.add("is-invalid");
                passwordInput.classList.add("is-invalid");

                return;
            }

            // Login สำเร็จ: ถ้ามี action ที่รออยู่ ให้ส่งฟอร์มนั้นต่อทันที
            if (pendingProtectedForm && pendingProtectedForm.isConnected) {
                const formToResume = pendingProtectedForm;
                pendingProtectedForm = null;
                window.bootstrap.Modal.getOrCreateInstance(loginModalElement).hide();
                formToResume.submit();
                return;
            }

            window.location.href = result.redirect || loginReturnTo.value || "/";

        } catch (error) {

            console.error("Login error:", error);

        }

    });

}

</script>
